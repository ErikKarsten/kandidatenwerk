# Vorlage für .env.staging - Staging-Umgebung (T-99, Paket 102). Eigenes Supabase-Projekt mit
# Testdaten. Gelesen von scripts/deploy-staging.sh (Werte kommen in den Staging-Worker),
# scripts/dev-staging.sh ("npm run dev") und scripts/staging-seed.ts.
# .env.local (Live) bleibt unverändert und kommt nie in den Staging-Worker.

# Staging-Supabase-Projekt (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Adresse von Staging, z. B. https://kandidatenwerk-staging.<konto>.workers.dev - steht nach
# dem ersten Deploy fest. Leer: Links in Mails zeigen auf Live.
NEXT_PUBLIC_APP_URL=

# Mails verschickt Staging nur an diese Domains oder Adressen (durch Komma getrennt, z. B.
# "firma.de" oder "name@firma.de"). Leer: Staging verschickt gar keine Mails.
MAIL_ALLOWLIST=
# Brevo-Schlüssel (darf derselbe wie live sein). Leer: Mail-Versand schlägt auf Staging fehl.
BREVO_API_KEY=

# Login des Staging-Admins (legt staging-seed.ts an; kommt nicht in den Worker). Die Testdaten
# nutzen Plus-Adressen davon (name+kanzlei@...), die Mails landen also im eigenen Postfach.
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=

# Bewusst NICHT eintragen: Meta, Close, Leadtable, Kanzleistelle24 - sonst greift Staging auf
# echte Kampagnen, Leads und Stellen zu.
