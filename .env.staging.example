# Vorlage für .env.staging (cp .env.staging.example .env.staging) - Staging-Umgebung (T-99).
# Eigenes Supabase-Projekt mit Testdaten. Wird nur von scripts/deploy-staging.sh und
# scripts/staging-seed.ts gelesen; .env.local bleibt unverändert.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Login des Staging-Admins (wird von staging-seed.ts angelegt)
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=
