# Vorlage für .env.local (cp .env.example .env.local). Lokal arbeitet die App gegen die
# LIVE-Datenbank - Schlüssel, die nicht gebraucht werden, leer lassen.

# --- Supabase (Pflicht) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-Role-Schlüssel, umgeht RLS (Admin-Aktionen, Skripte, Cron-Jobs)
SUPABASE_SECRET_KEY=

# --- Mails über Brevo (leer = kein Versand, sendEmail wirft einen Fehler) ---
BREVO_API_KEY=

# --- KI-Extraktion der Zusatzfelder (leer = wird übersprungen) ---
ANTHROPIC_API_KEY=
# KI über kie.ai (bevorzugt, wenn gesetzt; Claude-Modelle müssen für den Schlüssel freigegeben sein)
KIE_API_KEY=

# --- Leadtable ---
LEADTABLE_API_KEY=
LEADTABLE_ACCOUNT_EMAIL=

# --- Meta Lead Ads ---
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# optional, Standard v25.0
META_GRAPH_API_VERSION=

# --- Kanzleistelle24 (zweite Supabase-Datenbank) ---
KANZLEISTELLE_SUPABASE_URL=
KANZLEISTELLE_SUPABASE_SERVICE_KEY=

# --- Cron-Routen (/api/cron/*) und manueller Leadtable-Sync-Start ---
CRON_SECRET=
GITHUB_ACTIONS_TOKEN=
