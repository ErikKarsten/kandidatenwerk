{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kandidatenwerk",
  "main": "custom-worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "limits": {
    "subrequests": 1000
  },
  // Workers Logs (T-105): Serverfehler und console-Ausgaben 3 Tage im Cloudflare-Dashboard
  // (Workers > kandidatenwerk > Logs) durchsuchbar.
  "observability": {
    "enabled": true
  },
  // Rate-Limiting für Login und "Fehler melden" (src/lib/ratelimit.ts). namespace_id ist eine frei gewählte,
  // pro Cloudflare-Konto eindeutige Zahl; period nur 10 oder 60 Sekunden möglich.
  "ratelimits": [
    { "name": "LOGIN_LIMIT_EMAIL", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LOGIN_LIMIT_IP", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "BUG_REPORT_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],
  // Cloudflare Cron Triggers (UTC) - Zuordnung Ausdruck -> Route in custom-worker.ts.
  "triggers": {
    "crons": ["*/5 * * * *", "*/30 * * * *", "0 * * * *", "0 6 * * *"]
  },
  "routes": [
    { "pattern": "kandidatenwerk.kanzleistelle24.de", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kandidatenwerk"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Workers AI: Transkription von Close-Telefonaten (src/lib/transcribe.ts, Paket 30).
  "ai": {
    "binding": "AI"
  },
  // Staging (T-99): eigener Worker kandidatenwerk-staging auf workers.dev mit eigenem
  // Supabase-Projekt. Bauen/deployen nur über scripts/deploy-staging.sh (lädt .env.staging,
  // damit die NEXT_PUBLIC_*-Werte des Staging-Projekts in den Build kommen).
  // Bindings werden nicht vererbt und stehen deshalb hier noch einmal.
  "env": {
    "staging": {
      "name": "kandidatenwerk-staging",
      "routes": [],
      "workers_dev": true,
      // Gleiche Cronjobs wie live - Staging-Daten sind reine Testdaten.
      "triggers": {
        "crons": ["*/5 * * * *", "*/30 * * * *", "0 * * * *", "0 6 * * *"]
      },
      "ratelimits": [
        { "name": "LOGIN_LIMIT_EMAIL", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
        { "name": "LOGIN_LIMIT_IP", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
        { "name": "BUG_REPORT_LIMIT", "namespace_id": "2003", "simple": { "limit": 5, "period": 60 } }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "kandidatenwerk-staging"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "ai": {
        "binding": "AI"
      }
    }
  }
}
