{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kandidatenwerk",
  "main": "custom-worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "limits": {
    "subrequests": 1000
  },
  // Cloudflare Cron Triggers (UTC) - Zuordnung Ausdruck -> Route in custom-worker.ts.
  "triggers": {
    "crons": ["*/5 * * * *", "*/30 * * * *", "0 * * * *"]
  },
  "routes": [
    { "pattern": "kandidatenwerk.kanzleistelle24.de", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kandidatenwerk"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
