# Vorlage für .env.db - Datenbank-Verbindungen für scripts/sql.sh und scripts/staging-setup.sh
# (Paket 104). Bewusst eine eigene Datei: .env.local packt OpenNext beim Bauen in den Worker,
# .env.db liest weder Next.js noch OpenNext.
# Supabase > Connect > Direct > Session pooler, [YOUR-PASSWORD] durch das Datenbank-Passwort
# ersetzen (Sonderzeichen im Passwort URL-kodiert, z. B. @ als %40).
STAGING_DB_URL=
LIVE_DB_URL=
